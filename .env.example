# =====================================================================
# CORPUS MIND - ENVIRONMENT CONFIGURATION
# =====================================================================

# --- 11. Multi-Provider LLM & Cloud Configurations ---
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_API_URL=http://localhost:11434

# Cloud API Keys (Leave blank if using local Ollama only)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=
DEFAULT_ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Generation Controls
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=512
LLM_REQUEST_TIMEOUT=60

# --- 12 & 13 & 15. Prompts & Structured JSON Output ---
DEFAULT_PROMPT_TEMPLATE=question_answering
STRUCTURED_OUTPUT_ENABLED=false
DEFAULT_STRUCTURED_SCHEMA=general

# --- Advanced RAG Pipeline Configurations (Improvements #1 - #10) ---
DEFAULT_EMBEDDING_MODEL=all-MiniLM-L6-v2
DEFAULT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKING_ENABLED=true

DEFAULT_CHUNKING_STRATEGY=semantic
SEMANTIC_SIMILARITY_THRESHOLD=0.65
CHUNK_SIZE=500
CHUNK_OVERLAP=50

QUERY_REWRITING_ENABLED=true
MULTI_QUERY_ENABLED=true
MULTI_QUERY_COUNT=3

CONTEXTUAL_COMPRESSION_ENABLED=true
COMPRESSION_SIMILARITY_THRESHOLD=0.35

HYBRID_FUSION_METHOD=rrf
DENSE_SEARCH_WEIGHT=0.5
SPARSE_SEARCH_WEIGHT=0.5
DEFAULT_TOP_K=4

CONVERSATION_AWARE_ENABLED=true
MAX_CONVERSATION_HISTORY_TURNS=6
MAX_CONVERSATION_HISTORY_TOKENS=1000

PARENT_CHILD_ENABLED=true
PARENT_CHUNK_SIZE=1200
PARENT_CHUNK_OVERLAP=100
CHILD_CHUNK_SIZE=300
CHILD_CHUNK_OVERLAP=40

HALLUCINATION_DETECTION_ENABLED=true
FAITHFULNESS_THRESHOLD=0.70

# --- OCR Engine Configurations ---
DEFAULT_OCR_ENGINE=tesseract
OCR_LANG=eng
TESSERACT_CMD_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Security & Session ---
SESSION_TIMEOUT_MINUTES=30
