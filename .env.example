# ==============================================================
# Corpus Mind Environment Configuration Template (.env.example)
# ==============================================================

# -----------------
# 1. Relational Database Settings (SQLite / PostgreSQL)
# -----------------
# For SQLite (default local development):
DATABASE_URL=sqlite:///data/database.sqlite

# For PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://corpus_user:corpus_secure_password_123@localhost:5432/corpus_mind
# POSTGRES_USER=corpus_user
# POSTGRES_PASSWORD=corpus_secure_password_123
# POSTGRES_DB=corpus_mind
# POSTGRES_PORT=5432

# Database Connection Pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# -----------------
# 2. REST API & Security (FastAPI & JWT)
# -----------------
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# JWT Secret & Token Lifecycle
JWT_SECRET_KEY=change-this-to-a-very-secure-random-32-byte-secret-key!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Security & Sessions
SESSION_TIMEOUT_MINUTES=30
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=*
AUDIT_LOGS_ENABLED=true

# -----------------
# 3. LLM Providers & API Keys
# -----------------
# Default LLM Provider: 'ollama', 'openai', 'gemini', or 'anthropic'
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_MODEL=llama3.2

# Local Ollama URL
OLLAMA_API_URL=http://localhost:11434

# Cloud LLM API Keys (optional if using local Ollama)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------
# 4. Embeddings & Hybrid RAG Retrieval Engine
# -----------------
DEFAULT_EMBEDDING_MODEL=all-MiniLM-L6-v2
DEFAULT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKING_ENABLED=true

# Chunking & Splitting
CHUNK_SIZE=500
CHUNK_OVERLAP=50
DEFAULT_CHUNKING_STRATEGY=semantic
SEMANTIC_SIMILARITY_THRESHOLD=0.65

# Retrieval & Fusion
RAG_SEARCH_MODE=hybrid
HYBRID_FUSION_METHOD=rrf
RRF_K=60
DENSE_SEARCH_WEIGHT=0.5
SPARSE_SEARCH_WEIGHT=0.5
DEFAULT_TOP_K=4
DEFAULT_SIMILARITY_THRESHOLD=0.15

# Advanced RAG Controls
QUERY_REWRITING_ENABLED=true
MULTI_QUERY_ENABLED=true
MULTI_QUERY_COUNT=3
CONTEXTUAL_COMPRESSION_ENABLED=true
COMPRESSION_SIMILARITY_THRESHOLD=0.35
PARENT_CHILD_ENABLED=true
CONVERSATION_AWARE_ENABLED=true
HALLUCINATION_DETECTION_ENABLED=true
FAITHFULNESS_THRESHOLD=0.70

# -----------------
# 5. Multi-Pass OCR Engine
# -----------------
DEFAULT_OCR_ENGINE=tesseract
OCR_LANG=eng
TESSERACT_CMD_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
# For Linux / Docker:
# TESSERACT_CMD_PATH=/usr/bin/tesseract

# -----------------
# 6. Caching & Background Processing
# -----------------
EMBEDDING_CACHE_ENABLED=true
QUERY_CACHE_ENABLED=true
RETRIEVAL_CACHE_ENABLED=true
LLM_CACHE_ENABLED=false
CACHE_MAX_ENTRIES=5000
CACHE_TTL_SECONDS=86400
ASYNC_WORKER_CONCURRENCY=3
INCREMENTAL_INDEXING_ENABLED=true
